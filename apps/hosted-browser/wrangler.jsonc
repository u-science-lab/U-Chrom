{
	"name": "uchrom-browser",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"containers": [
		{
			"class_name": "UChromBrowser",
			"image": "./Dockerfile",
			"image_build_context": "../..",
			"instance_type": "standard-1",
			"max_instances": 4
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "UCHROM", "class_name": "UChromBrowser" },
			{ "name": "HANDOFFS", "class_name": "UChromHandoff" }
		]
	},
	"exports": {
		"UChromBrowser": { "type": "durable-object", "storage": "sqlite" },
		"UChromHandoff": { "type": "durable-object", "storage": "sqlite" }
	},
	"observability": { "enabled": true },
	"vars": { "INSTANCES": "2", "RELEASE": "r16" },
	"routes": [{ "pattern": "uchrom-browser.u-science.org", "custom_domain": true }]
}
