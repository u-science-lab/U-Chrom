{
 "panel": "b",
 "title": "What each format can represent",
 "marks": {
  "native": "first-class, with its own structure",
  "linked": "held as an external community-standard file (not copied) and queried through the shared index",
  "convention": "representable by convention: stored and read back through the public API in a general-purpose slot, structure lost or ad hoc",
  "none": "not supported"
 },
 "rules": [
  "if in doubt the other tool gets the better mark (noted)",
  "AnnData elements rated in their most favourable orientation",
  "a data table serialised to JSON text in a descriptive metadata attribute does not count (recorded with counted: false); provenance-like metadata there does"
 ],
 "rows": [
  "chromdata.zarr",
  "FOF-CT (4DN)",
