{
 "what": "wall time to compute ONE single-cell model (seed 1), Stevens 2017 Cell 1, per method and resolution",
 "input": "GSM2219497_Cell_1_contact_pairs.txt.gz (GSE80280, haploid mESC, full contact table, 111,838 contacts); same file for all methods",
 "timed": "method's own work from its input table to its model file (contact parsing, filtering / preparation, annealing / simulation, model output); excluded: environment setup, conversion of the GEO table to NCC (original) / .pairs (hickit) and of the outputs to .npz (wall_total_seconds includes them)",
 "hardware": {
  "cpu": [
   "AMD EPYC 9754 128-Core Processor"
  ],
  "gpu": [
   "NVIDIA H100 80GB HBM3, 81559 MiB, 550.163.01"
  ],
  "cpu_runs": "Slurm --constraint=CPU_SKU:9754 (AMD EPYC 9754, 256-core nodes, shared with other jobs), --cpus-per-task = thread count, one process per run",
  "gpu_runs": "one NVIDIA H100 SXM5 80 GB (-G 1, -C GPU_SKU:H100_SXM5), wgpu / Vulkan, f32"
 },
 "threads": "1 thread for every CPU method (original NucDynamics, hickit and Si-C are single-threaded per model); U-Chrom CPU (and robust CPU) also with 16 threads (parallel force loops)",
 "cap_hours": 48.0,
 "repeats": "<= 15 min: 3 runs, <= 1 h: 2 runs, longer: 1 run; median reported; same seed in every repeat",
 "schedules": {
  "nucdyn": "2017 schedule extended below 100 kb (8, 4, 2, 0.4, 0.2, 0.1, 0.05, 0.02, 0.01, 0.005, 0.002, 0.001 Mb), truncated above the target, target appended; 500 temperature x 100 dynamics steps per stage",
  "hickit": "Dip-C: -r1m -c1 -r10m -c5 then -b4m -b1m -b200k (-D5 -b50k) (-D5 -b20k) truncated above the target, -b<target> appended, -P1 (haploid, no -S / imputation); empty beads merged",
  "sic": "Si-C's own ladder: res x 2^k < 2 Mb, refined down to res (integer kb); one replica"
 },
 "caveats": [
  "Si-C runs its precompiled x86-64 binaries (the C sources cannot be rebuilt); its 1 kb contact preparation is re-done in Python (the shipped script needs MySQL's `replace`).",
  "hickit merges consecutive beads without contacts, so it simulates far fewer beads than the nominal resolution (n_particles = its final bead count; n_particles_grid = the regular grid).",
  "Each method uses its own schedule (stages, steps); times are for each method's default protocol at the target resolution, not for equal work.",
  "CPU nodes are shared with other jobs (fixed core count, not exclusive): memory bandwidth contention can add noise; load averages are in the records.",
  "The GPU runs use 8 host cores of the GPU node (Intel Xeon 8462Y+), a different CPU from the CPU runs."
 ],
