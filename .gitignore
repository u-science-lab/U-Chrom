example-data/bintu2018_imr90/IMR90_chr21_pyhim.ecsv
!example-data/mesc_sox2/*.h5cd
!example-data/sim_cell1/sim_cell1.cdz
!example-data/sim_cell1/*.h5cd
!example-data/sim_cell1/*.mcool
example-data/h1esc_hff_scihic/
example-data/gm12878_hic/
# tutorial / benchmark outputs (with_loops, fofct_core.csv, fig2_work/, ...)
example-data/generated/
# built datasets: everything but the build script / README
example-data/takei2025_fov0/*
example-data/takei2025_cerebellum/*
example-data/schicar_mop/*
example-data/liu2025_mop/*
