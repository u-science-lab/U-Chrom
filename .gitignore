# Docs build
docs/build/
.ipynb_checkpoints/
# Stray nested worktree paths must never be committed
.claude/worktrees/

# Fig 6c benchmark inputs (replicated Takei 2025 FOV 0; benchmarks/fig6/make_scaled.py)
benchmarks/fig6/_data/

# Fig 6e agent benchmark: answer key, figure data and grades are tracked; raw agent
# transcripts (~40 MB per run) stay local (archive with the paper's data).
!benchmarks/fig6/agent_bench/answers.json
benchmarks/fig6/agent_bench/runs/**
!benchmarks/fig6/agent_bench/runs/**/
!benchmarks/fig6/agent_bench/runs/**/grades.json

# real-data validation results (benchmarks/*_validation.py --out)
!benchmarks/results/*.json

# generated by deploying the apps (atlas page, hosted browser; wrangler)
apps/atlas/deploy/dist/
apps/*/node_modules/
apps/**/.wrangler/

# Native NucDynamics engine (packages/uchrom-recon): cargo build output, built extension
packages/uchrom-recon/target/
packages/uchrom-recon/python/uchrom_recon/*.so
packages/uchrom-recon/python/uchrom_recon/*.pyd
# Native kernels of the Hi-C map callers (packages/uchrom-maps)
packages/uchrom-maps/target/
packages/uchrom-maps/python/uchrom_maps/*.so
packages/uchrom-maps/python/uchrom_maps/*.pyd

# Fig. 3 renders: rebuildable inputs and raw pane captures (the cropped PNGs used in the figures are tracked)

# The manuscripts and figures live in u-science-lab/u-chrom-paper (moved out of paper/ on 2026-10-05);
# a leftover paper/ folder in an old worktree must not come back; a symlink paper -> ../u-chrom-paper
# (to browse the paper next to the code) is ignored too.
/paper

# monorepo packages: build output of non-editable installs
packages/*/build/
packages/*/*.egg-info/

# tutorial outputs (the notebooks write under tutorials/_out/)
tutorials/_out/

# Data live outside the repository: $UCHROM_DATA, else ~/.cache/uchrom (python -m uchrom.datasets).
# The example-data/ folder of earlier checkouts holds local data only.
/example-data/
/data/

# tracked despite the data rules above (*.csv, *.json, *.cdz, *.mcool, *.chromdata.zarr):
# the packages' test fixtures and the recipes' pipeline tables
!packages/*/tests/fixtures/**
!apps/atlas/recipes/**
# ... but never byte code
__pycache__/
*.pyc

# code revision of a repo copy synced to a cluster (benchmarks/_record.py)
/REVISION
