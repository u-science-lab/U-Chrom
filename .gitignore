# ---- example-data/: one folder per dataset (catalog: example-data/README.md) ----
# Downloaded / built payloads stay out of git; the scripts and READMEs that
# live next to them are tracked.  Keep this block after the global
# *.csv / *.h5cd / *.mcool / *.cdz / *.tar.gz rules so the ! re-includes win.
example-data/**/*.zip
example-data/takei2021_mesc/4DNFIHF3JCBY.*
example-data/takei2021_mesc/DNAseqFISH+/
!example-data/takei2021_mesc/4DNFIFINA2U9.csv
!example-data/takei2021_mesc/4DNFIJ52NVDV.csv
